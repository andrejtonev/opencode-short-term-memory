{
  // Session memory plugin on/off
  "enabled": true,

  // Model used by the summarizer (provider/model), in both V1 and V2.
  // Blank clean mode uses the fresh session's host default; blank active uses the current session model.
  // A valid explicit override applies in either mode.
  "memoryModel": "",

  // clean | active
  "summarizerMode": "clean",

  // If true, eligible exhausted clean failures may fall back to active generation.
  // Permanent provider failures do not retry or fall back.
  // V2 also excludes timeout/cancellation and uses the remaining chunk deadline; overrides are retained.
  "cleanFallbackToActiveSession": false,

  // If true, include AGENTS.md content in the first memory update prompt per session
  "includeAgentsMdOnFirstUpdate": false,

  // If true, deliver a frozen parent-memory snapshot to eligible child sessions.
  // Children do not summarize; observed child creation captures the snapshot in both generations.
  "injectInSubagents": true,

  // Number of additional clean attempts (0 = no retry). Active mode does not use this retry loop.
  // Clean attempts use fresh owned sessions; permanent provider failures stop retries.
  // V2 shares one chunk deadline across retries and fallback.
  "sideSessionRetries": 1,

  // Select system/context delivery in clean mode; otherwise use session-message delivery.
  // Active mode always uses session-message delivery, even when this selector is true.
  "enableLegacyPeriodicSystemTransform": false,

  // Deliver saved memory every N eligible user turns in either primary delivery mode.
  "remindEveryN": 4,

  // Target length for stored session memory markdown; a complete line plus metadata can exceed it.
  "maxMemoryLength": 10000,

  // Max conversation-content chars per update chunk; prompt overhead is not included.
  "maxUpdateInputLength": 20000,

  // Recent-history look-back limit in both generations; reset anchors are located before this limit.
  "maxDeltaMessages": 200,

  // Collapse consecutive visible assistant replies between user turns into the last reply.
  // Internal/reasoning parts are filtered before this option; false keeps every visible reply.
  "collapseAssistantBursts": false,

  // Debounce for scheduled updates (ms)
  "debounceMs": 1200,

  // Additional diagnostic metadata. New logs omit prompts, conversation and memory previews.
  // Recognizable credentials are redacted; existing logs are not rewritten.
  "debug": false,

  // Max JSONL lines kept in .opencode/memory/session-memory.log
  "logMaxLines": 300,

  // Directory for memory files, checkpoints, and logs (relative to process CWD, not guaranteed project root).
  "memoryDir": ".opencode/memory",
}
