{
  // Session memory plugin on/off
  "enabled": true,

  // Model used by the summarizer. V1 clean mode omits an empty override and lets the host resolve it.
  // V2 uses the current session model when empty; an explicit override is unsupported in active mode.
  "memoryModel": "",

  // clean | active
  "summarizerMode": "clean",

  // If true, clean-mode failures may fall back to the active session after retries.
  // V1 catches failures after retries; V2 permits only settled retryable clean failures (not explicit override, timeout, or cancellation).
  "cleanFallbackToActiveSession": false,

  // If true, include AGENTS.md content in the first memory update prompt per session
  "includeAgentsMdOnFirstUpdate": false,

  // If true, inject parent memory into eligible task children.
  // Parent-memory snapshots: V1 subagents at creation; V2 task children on first eligible read, gated by injection settings.
  "injectInSubagents": true,

  // Number of retries after clean generation failures (0 = no retry).
  // V1 creates a fresh side session for each attempt; V2 uses bounded standalone generation attempts.
  "sideSessionRetries": 1,

  // V1 selects legacy system-transform transport; V2 gates all system injection.
  "enableLegacyPeriodicSystemTransform": false,

  // Inject every N eligible user turns when delivery is enabled; V2 also requires the gate above.
  "remindEveryN": 4,

  // Target length for stored session memory markdown; a complete line plus metadata can exceed it.
  "maxMemoryLength": 10000,

  // Max conversation-content chars per update chunk; prompt overhead is not included.
  "maxUpdateInputLength": 20000,

  // V1 look-back limit; V2 applies this limit per update chunk.
  "maxDeltaMessages": 200,

  // Collapse consecutive visible assistant replies between user turns into the last reply.
  // Internal/reasoning parts are filtered before this option; false keeps every visible reply.
  "collapseAssistantBursts": false,

  // Debounce for scheduled updates (ms)
  "debounceMs": 1200,

  // Debug logging
  "debug": false,

  // Max JSONL lines kept in .opencode/memory/session-memory.log
  "logMaxLines": 300,

  // Directory for memory files, checkpoints, and logs (relative to process CWD, not guaranteed project root).
  "memoryDir": ".opencode/memory",
}
